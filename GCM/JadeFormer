# --- 1. 基础模块 (Building Blocks) ---

class RMSNorm(nn.Module):
    """ RMSNorm, a replacement for LayerNorm for stability. """
    def __init__(self, dim, eps=1e-6):
        super().__init__()
        self.scale = dim ** 0.5
        self.eps = eps
        self.gamma = nn.Parameter(torch.ones(dim))

    def forward(self, x):
        # x.norm(2, dim=-1, keepdim=True) is the L2 norm
        norm = x.norm(2, dim=-1, keepdim=True)
        # (self.scale / norm.clamp(min=self.eps)) is the scaling factor
        return x * (self.scale / norm.clamp(min=self.eps)) * self.gamma


class PatchEmbed(nn.Module):
    """ Image to Patch Embedding """
    def __init__(self, img_size=224, patch_size=4, in_chans=3, embed_dim=96):
        super().__init__()
        self.img_size = (img_size, img_size)
        self.patch_size = (patch_size, patch_size)
        self.grid_size = (self.img_size[0] // self.patch_size[0], self.img_size[1] // self.patch_size[1])
        self.num_patches = self.grid_size[0] * self.grid_size[1]

        self.proj = nn.Conv2d(in_chans, embed_dim, kernel_size=patch_size, stride=patch_size)
        self.norm = RMSNorm(embed_dim)

    def forward(self, x):
        B, C, H, W = x.shape
        assert H == self.img_size[0] and W == self.img_size[1], \
            f"Input image size ({H}x{W}) doesn't match model ({self.img_size[0]}x{self.img_size[1]})."
        x = self.proj(x).flatten(2).transpose(1, 2)  # B, num_patches, C
        x = self.norm(x)
        return x


class PatchMerging(nn.Module):
    """ Patch Merging Layer. """
    def __init__(self, dim, norm_layer=RMSNorm):
        super().__init__()
        self.dim = dim
        self.reduction = nn.Linear(4 * dim, 2 * dim, bias=False)
        self.norm = norm_layer(4 * dim)

    def forward(self, x, H, W):
        B, L, C = x.shape
        assert L == H * W, "input feature has wrong size"
        x = x.view(B, H, W, C)

        x0 = x[:, 0::2, 0::2, :]  # B H/2 W/2 C
        x1 = x[:, 1::2, 0::2, :]  # B H/2 W/2 C
        x2 = x[:, 0::2, 1::2, :]  # B H/2 W/2 C
        x3 = x[:, 1::2, 1::2, :]  # B H/2 W/2 C
        x = torch.cat([x0, x1, x2, x3], -1)  # B H/2 W/2 4*C
        x = x.view(B, -1, 4 * C)  # B, (H/2)*(W/2), 4*C

        x = self.norm(x)
        x = self.reduction(x)
        return x


class Mlp(nn.Module):
    """ Standard two-layer MLP. """
    def __init__(self, in_features, hidden_features=None, out_features=None, act_layer=nn.GELU, drop=0.):
        super().__init__()
        out_features = out_features or in_features
        hidden_features = hidden_features or in_features
        self.fc1 = nn.Linear(in_features, hidden_features)
        self.act = act_layer()
        self.fc2 = nn.Linear(hidden_features, out_features)
        self.drop = nn.Dropout(drop)

    def forward(self, x):
        x = self.fc1(x)
        x = self.act(x)
        x = self.drop(x)
        x = self.fc2(x)
        x = self.drop(x)
        return x


# --- 2. 核心创新模块 (Core Innovations) ---

class GRPB(nn.Module):
    """ Graph Relative Position Bias """
    def __init__(self, window_size, num_heads):
        super().__init__()
        self.window_size = window_size
        self.num_heads = num_heads
        # Create relative coordinates
        coords = torch.stack(torch.meshgrid([torch.arange(window_size), torch.arange(window_size)], indexing='ij'))  # 2, Wh, Ww
        coords_flatten = torch.flatten(coords, 1)  # 2, Wh*Ww
        relative_coords = coords_flatten[:, :, None] - coords_flatten[:, None, :]  # 2, Wh*Ww, Wh*Ww
        relative_coords = relative_coords.permute(1, 2, 0).contiguous()  # Wh*Ww, Wh*Ww, 2
        relative_coords = relative_coords.float()

        # Scale to range [-1, 1] for MLP input
        relative_coords[:, :, 0] /= (window_size - 1)
        relative_coords[:, :, 1] /= (window_size - 1)
        self.register_buffer("relative_coords", relative_coords)

        # Lightweight MLP to generate bias
        self.mlp = nn.Sequential(
            nn.Linear(2, 64, bias=True),
            nn.ReLU(inplace=True),
            nn.Linear(64, num_heads, bias=True)
        )

    def forward(self,):
        # The paper implies dynamic generation, so we pass coords through MLP in each forward pass
        bias = self.mlp(self.relative_coords) # Ww*Wh, Ww*Wh, nH
        return bias.permute(2, 0, 1).contiguous() # nH, Ww*Wh, Ww*Wh


class PFFM(nn.Module):
    """ Prior Feature Fusion Module using Bi-directional Cross-Attention """
    def __init__(self, dim, num_prototypes, num_heads, norm_layer=RMSNorm):
        super().__init__()
        self.prototypes = nn.Parameter(torch.randn(1, num_prototypes, dim))
        
        self.norm1_p = norm_layer(dim)
        self.norm1_x = norm_layer(dim)
        self.cross_attn1 = nn.MultiheadAttention(dim, num_heads, batch_first=True)

        self.norm2_p = norm_layer(dim)
        self.norm2_x = norm_layer(dim)
        self.cross_attn2 = nn.MultiheadAttention(dim, num_heads, batch_first=True)

    def forward(self, x):
        # Prototypes -> Image Feature Update
        p = self.prototypes.expand(x.size(0), -1, -1)
        p_updated = p + self.cross_attn1(query=self.norm1_p(p), key=self.norm1_x(x), value=self.norm1_x(x))[0]

        # Image -> Updated Prototypes Feature Fusion
        x_fused = x + self.cross_attn2(query=self.norm2_x(x), key=self.norm2_p(p_updated), value=self.norm2_p(p_updated))[0]
        
        return x_fused

class CompositionalWindowAttention(nn.Module):
    def __init__(self, dim, window_size=7, num_heads=8, qkv_bias=True,
                 attn_drop=0., proj_drop=0., rank=4):
        super().__init__()
        self.dim = dim
        self.window_size = (window_size, window_size)
        self.num_heads = num_heads
        head_dim = dim // num_heads
        self.scale = head_dim ** -0.5
        self.rank = rank

        self.qkv = nn.Linear(dim, dim * 3, bias=qkv_bias)
        self.attn_drop = nn.Dropout(attn_drop)
        self.proj = nn.Linear(dim, dim)
        self.proj_drop = nn.Dropout(proj_drop)

        # ---- 动态缩放 + HyperNet ----
        hidden_hyper = max(128, dim // 4)
        # 一条线输出 scale_q, scale_k (2*C)
        self.dynamic_mlp = nn.Sequential(
            nn.Linear(dim, hidden_hyper),
            nn.ReLU(inplace=True),
            nn.Linear(hidden_hyper, 2 * dim)
        )
        # 另一条线输出 ΔWq, ΔWk
        self.hyper = nn.Sequential(
            nn.Linear(dim, hidden_hyper),
            nn.ReLU(inplace=True),
            nn.Linear(hidden_hyper, 2 * num_heads * head_dim * head_dim)
        )
        nn.init.zeros_(self.hyper[-1].weight)
        nn.init.zeros_(self.hyper[-1].bias)

        self.grpb = GRPB(window_size=window_size, num_heads=num_heads)
        self.pre_proj_A  = nn.Parameter(torch.randn(num_heads, rank) * 0.02)
        self.pre_proj_B  = nn.Parameter(torch.randn(num_heads, rank) * 0.02)
        self.post_proj_A = nn.Parameter(torch.randn(head_dim, rank) * 0.02)
        self.post_proj_B = nn.Parameter(torch.randn(head_dim, rank) * 0.02)
        self.low_rank_matrices = [self.pre_proj_A, self.pre_proj_B,
                                  self.post_proj_A, self.post_proj_B]
        self.softmax = nn.Softmax(dim=-1)

    def forward(self, x, mask=None):
        B_, N, C = x.shape
        h, d = self.num_heads, C // self.num_heads

        # 1. QKV
        qkv = self.qkv(x).reshape(B_, N, 3, h, d).permute(2, 0, 3, 1, 4)
        q, k, v = qkv[0], qkv[1], qkv[2]          # B_, h, N, d

        # 2. 全局描述符
        glob = x.mean(dim=1)                       # B_, C

        # 3. 动态缩放（只产生 B_, h, d -> 扩到 B_, h, 1, d）
        scales = self.dynamic_mlp(glob).view(B_, 2, h, d)
        scale_q, scale_k = scales[:, 0].unsqueeze(2), scales[:, 1].unsqueeze(2)
        q = q * scale_q
        k = k * scale_k

        # 4. HyperNet 增量矩阵
        delta = self.hyper(glob).view(B_, 2, h, d, d)
        delta_q, delta_k = delta[:, 0], delta[:, 1]          # B_, h, d, d
        eye = torch.eye(d, device=x.device).unsqueeze(0).unsqueeze(0)
        q = torch.einsum('bhnd,bhdc->bhnc', q, eye + delta_q)
        k = torch.einsum('bhnd,bhdc->bhnc', k, eye + delta_k)

        # 5. 注意力
        q = q * self.scale
        attn = (q @ k.transpose(-2, -1))                    # B_, h, N, N

        # 6. 低秩跨头融合
        attn = rearrange(attn, 'b h n m -> b n m h')
        pre_mat = self.pre_proj_A @ self.pre_proj_B.t()
        attn = attn @ pre_mat
        attn = rearrange(attn, 'b n m h -> b h n m')

        attn = attn + self.grpb().unsqueeze(0)
        if mask is not None:
            nW = mask.shape[0]
            attn = attn.view(B_ // nW, nW, h, N, N) + mask.unsqueeze(1).unsqueeze(0)
            attn = attn.view(-1, h, N, N)
        attn = self.softmax(attn)
        attn = self.attn_drop(attn)

        x = (attn @ v)                                        # B_, h, N, d
        x = rearrange(x, 'b h n d -> b n h d')
        post_mat = self.post_proj_A @ self.post_proj_B.t()
        x = x @ post_mat
        x = rearrange(x, 'b n h d -> b n (h d)')

        x = self.proj(x)
        x = self.proj_drop(x)
        return x

# --- 3. 主要网络结构 (Main Architecture) ---

def window_partition(x, window_size):
    B, H, W, C = x.shape
    x = x.view(B, H // window_size, window_size, W // window_size, window_size, C)
    windows = x.permute(0, 1, 3, 2, 4, 5).contiguous().view(-1, window_size, window_size, C)
    return windows

def window_reverse(windows, window_size, H, W):
    B = int(windows.shape[0] / (H * W / window_size / window_size))
    x = windows.view(B, H // window_size, W // window_size, window_size, window_size, -1)
    x = x.permute(0, 1, 3, 2, 4, 5).contiguous().view(B, H, W, -1)
    return x

class CWBlock(nn.Module):
    """ Compositional Window Block (CW Block) """
    def __init__(self, dim, num_heads, window_size=7, shift_size=0,
                 mlp_ratio=4., qkv_bias=True, drop=0., attn_drop=0.,
                 norm_layer=RMSNorm):
        super().__init__()
        self.dim = dim
        self.num_heads = num_heads
        self.window_size = window_size
        self.shift_size = shift_size
        self.mlp_ratio = mlp_ratio
        assert 0 <= self.shift_size < self.window_size, "shift_size must in [0, window_size)"

        self.norm1 = norm_layer(dim)
        self.attn = CompositionalWindowAttention(
            dim, window_size=self.window_size, num_heads=num_heads,
            qkv_bias=qkv_bias, attn_drop=attn_drop, proj_drop=drop)

        self.norm2 = norm_layer(dim)
        mlp_hidden_dim = int(dim * mlp_ratio)
        self.mlp = Mlp(in_features=dim, hidden_features=mlp_hidden_dim, drop=drop)
        
    def forward(self, x, H, W, attn_mask):
        B, L, C = x.shape
        assert L == H * W, "input feature has wrong size"
        
        shortcut = x
        x = self.norm1(x)
        x = x.view(B, H, W, C)

        # cyclic shift
        if self.shift_size > 0:
            shifted_x = torch.roll(x, shifts=(-self.shift_size, -self.shift_size), dims=(1, 2))
        else:
            shifted_x = x

        # partition windows
        x_windows = window_partition(shifted_x, self.window_size)  # nW*B, window_size, window_size, C
        x_windows = x_windows.view(-1, self.window_size * self.window_size, C)  # nW*B, window_size*window_size, C

        # W-MSA/SW-MSA
        attn_windows = self.attn(x_windows, mask=attn_mask)  # nW*B, window_size*window_size, C

        # merge windows
        attn_windows = attn_windows.view(-1, self.window_size, self.window_size, C)
        shifted_x = window_reverse(attn_windows, self.window_size, H, W)  # B H' W' C

        # reverse cyclic shift
        if self.shift_size > 0:
            x = torch.roll(shifted_x, shifts=(self.shift_size, self.shift_size), dims=(1, 2))
        else:
            x = shifted_x
        x = x.view(B, H * W, C)

        # FFN
        x = shortcut + x
        x = x + self.mlp(self.norm2(x))

        return x


class BasicLayer(nn.Module):
    """ A basic Swin Transformer layer for one stage. """
    def __init__(self, dim, depth, num_heads, window_size,
                 mlp_ratio=4., qkv_bias=True, drop=0., attn_drop=0.,
                 downsample=None, norm_layer=RMSNorm, use_checkpoint=False,
                 pffm_prototypes=0):
        super().__init__()
        self.dim = dim
        self.depth = depth
        self.use_checkpoint = use_checkpoint

        # Prior Feature Fusion Module (PFFM)
        if pffm_prototypes > 0:
            self.pffm = PFFM(dim=dim, num_prototypes=pffm_prototypes, num_heads=num_heads, norm_layer=norm_layer)
        else:
            self.pffm = None
            
        # build blocks
        self.blocks = nn.ModuleList([
            CWBlock(dim=dim,
                    num_heads=num_heads,
                    window_size=window_size,
                    shift_size=0 if (i % 2 == 0) else window_size // 2,
                    mlp_ratio=mlp_ratio,
                    qkv_bias=qkv_bias,
                    drop=drop,
                    attn_drop=attn_drop,
                    norm_layer=norm_layer)
            for i in range(depth)])

        # patch merging layer
        if downsample is not None:
            self.downsample = downsample(dim=dim, norm_layer=norm_layer)
        else:
            self.downsample = None

    def create_mask(self, x, H, W):
        # calculate attention mask for SW-MSA
        img_mask = torch.zeros((1, H, W, 1), device=x.device)  # 1 H W 1
        h_slices = (slice(0, -self.blocks[0].window_size),
                    slice(-self.blocks[0].window_size, -self.blocks[0].shift_size),
                    slice(-self.blocks[0].shift_size, None))
        w_slices = (slice(0, -self.blocks[0].window_size),
                    slice(-self.blocks[0].window_size, -self.blocks[0].shift_size),
                    slice(-self.blocks[0].shift_size, None))
        cnt = 0
        for h in h_slices:
            for w in w_slices:
                img_mask[:, h, w, :] = cnt
                cnt += 1

        mask_windows = window_partition(img_mask, self.blocks[0].window_size)  # nW, window_size, window_size, 1
        mask_windows = mask_windows.view(-1, self.blocks[0].window_size * self.blocks[0].window_size)
        attn_mask = mask_windows.unsqueeze(1) - mask_windows.unsqueeze(2)
        attn_mask = attn_mask.masked_fill(attn_mask != 0, float(-100.0)).masked_fill(attn_mask == 0, float(0.0))
        return attn_mask

    def forward(self, x, H, W):
        # PFFM fusion at the start of the stage
        if self.pffm is not None:
            x = self.pffm(x)

        attn_mask = self.create_mask(x, H, W)
        for blk in self.blocks:
            if self.use_checkpoint:
                x = checkpoint(blk, x, H, W, attn_mask)
            else:
                x = blk(x, H, W, attn_mask)
                
        if self.downsample is not None:
            x_down = self.downsample(x, H, W)
            Wh, Ww = (H + 1) // 2, (W + 1) // 2
            return x, H, W, x_down, Wh, Ww
        else:
            return x, H, W, x, H, W

    def get_regularization_loss(self):
        """ Gathers L1 loss for low-rank matrices from all CWBlocks """
        reg_loss = 0.
        for blk in self.blocks:
            for param in blk.attn.low_rank_matrices:
                reg_loss += torch.norm(param, 1)
        return reg_loss

class DMSEncoder(nn.Module):
    """
    Dynamic Multi-Scale Encoder (DMS Encoder)
    """
    def __init__(self, img_size=224, patch_size=4, in_chans=3,
                 embed_dim=96, depths=[2, 2, 6, 2], num_heads=[3, 6, 12, 24],
                 window_size=7, mlp_ratio=4., qkv_bias=True,
                 drop_rate=0., attn_drop_rate=0., norm_layer=RMSNorm,
                 use_checkpoint=False, num_prototypes=50):
        super().__init__()

        self.num_layers = len(depths)
        self.embed_dim = embed_dim
        self.patch_embed = PatchEmbed(
            img_size=img_size, patch_size=patch_size, in_chans=in_chans, embed_dim=embed_dim)
        
        self.patch_grid = self.patch_embed.grid_size
        self.num_patches = self.patch_embed.num_patches
        self.pos_drop = nn.Dropout(p=drop_rate)

        # build layers
        self.layers = nn.ModuleList()
        for i_layer in range(self.num_layers):
            layer = BasicLayer(dim=int(embed_dim * 2 ** i_layer),
                               depth=depths[i_layer],
                               num_heads=num_heads[i_layer],
                               window_size=window_size,
                               mlp_ratio=mlp_ratio,
                               qkv_bias=qkv_bias,
                               drop=drop_rate,
                               attn_drop=attn_drop_rate,
                               downsample=PatchMerging if (i_layer < self.num_layers - 1) else None,
                               norm_layer=norm_layer,
                               use_checkpoint=use_checkpoint
                               )
            self.layers.append(layer)
        
        self.pffm = PFFM(
            dim=int(embed_dim * 2 ** (self.num_layers - 1)),
            num_prototypes=num_prototypes,
            num_heads=num_heads[-1],
            norm_layer=norm_layer
        ) 
        # Final normalization layer
        self.norm = norm_layer(int(embed_dim * 2**(self.num_layers-1)))
        
        self.apply(self._init_weights)

    def _init_weights(self, m):
        if isinstance(m, nn.Linear):
            nn.init.trunc_normal_(m.weight, std=.02)
            if isinstance(m, nn.Linear) and m.bias is not None:
                nn.init.constant_(m.bias, 0)
        elif isinstance(m, nn.LayerNorm) or isinstance(m, RMSNorm):
            # 如果存在 bias，就初始化 bias
            if hasattr(m, 'bias') and m.bias is not None:
                nn.init.constant_(m.bias, 0)
            # 如果存在 weight，就初始化 weight（LayerNorm）
            if hasattr(m, 'weight') and m.weight is not None:
                nn.init.constant_(m.weight, 1.0)
            # 如果存在 gamma，就初始化 gamma（RMSNorm）
            if hasattr(m, 'gamma'):
                nn.init.constant_(m.gamma, 1.0)


    def forward(self, x):
        x = self.patch_embed(x)
        x = self.pos_drop(x)
        
        H, W = self.patch_grid

        for layer in self.layers:
            x_out, H, W, x, H, W = layer(x, H, W)

        x_out = self.pffm(x_out)

        x = self.norm(x_out) # B L C
        
        # Take the average of the patch features as the global representation
        return torch.mean(x, dim=1)
    
    def get_total_regularization_loss(self):
        total_reg_loss = 0.
        for layer in self.layers:
            total_reg_loss += layer.get_regularization_loss()
        return total_reg_loss


